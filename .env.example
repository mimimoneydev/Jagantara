# Server-only Qloo credential issued through the hackathon request form.
# Never prefix it with NEXT_PUBLIC_ or send it to browser code.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional narrative composition through OpenRouter. The seeded demo works without an LLM.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
